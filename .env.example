# Kopiera till .env.local och fyll i. Inga hemligheter i repot.

# MySQL. Lokalt: Hostingers Remote MySQL-värd (din IP måste vitlistas i hPanel).
# På Hostinger-noden: localhost-varianten.
DATABASE_URL="mysql://användare:lösenord@127.0.0.1:3306/databas"

# ENDA stället där domänen finns. Domänbyte = env-ändring, aldrig refaktorering.
# Steg A: https://<slot>.hostingersite.com — steg B: https://sitio.com.py
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Minst 32 tecken: openssl rand -base64 48
# Roterar också preview-tokens och analytics-dagsaltet.
SESSION_SECRET=""

# Skyddar /api/cron/rollup mot publika anrop: openssl rand -hex 32
CRON_SECRET=""

# Absolut sökväg UTANFÖR deploy-trädet — git-deployen skriver om appkatalogen.
# Hostinger: /home/<user>/uploads/sitio
UPLOADS_DIR="/absolut/sökväg/utanför/repot"

# Valfria
# Timförskjutning från databasens klocka till Asunción-dygnet i rollupen.
# Default -3 förutsätter att MySQL står på UTC (verifiera: select now(), utc_timestamp()).
ANALYTICS_TZ_OFFSET_HOURS="-3"
# Trösklar för hot-lead-flaggan (PR-16).
HOT_LEAD_WA_CLICKS_30D="15"
HOT_LEAD_VIEWS_30D="300"
# AI-puts ("Pulir textos"), fas 2.
ANTHROPIC_API_KEY=""
# Seed-inloggning (scripts/seed-dev.ts).
SEED_ADMIN_EMAIL="anton@sitio.com.py"
SEED_ADMIN_PASSWORD="sitio-dev-1234"
